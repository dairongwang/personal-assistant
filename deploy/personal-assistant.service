# systemd unit (Linux). Install:
#   sudo cp deploy/personal-assistant.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now personal-assistant
# Adjust User= and the paths below to your checkout location, then:
#   sudo useradd --system --home /var/lib/personal-assistant --create-home assistant
[Unit]
Description=Personal Assistant (FastAPI)
After=network.target

[Service]
User=assistant
WorkingDirectory=/opt/personal-assistant/backend
Environment=DATA_DIR=/var/lib/personal-assistant
ExecStart=/opt/personal-assistant/backend/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/personal-assistant
PrivateTmp=true

[Install]
WantedBy=multi-user.target
