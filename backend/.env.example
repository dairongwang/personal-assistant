# Copy to backend/.env to override defaults (all optional).

# Where the SQLite database lives (default: backend/data/). Docker sets /app/data.
#DATA_DIR=./data
# Or a full SQLAlchemy URL instead:
#DATABASE_URL=sqlite:///./data/assistant.db

# Timezone for "today" when a client does not send one (the web app always does).
#DEFAULT_TZ=Europe/Berlin

# Only needed if the frontend is served from a different origin than the API.
#CORS_ORIGINS=http://localhost:3000

# Port used by `python dev.py run` / `serve` and docker compose.
#PORT=8000
