# Copy to services/account/.env to override defaults (all optional locally, required in the cloud).

# PostgreSQL (Azure Database for PostgreSQL Flexible Server in the cloud). SQLite only for tests.
#DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/assistant

# dev | test | qa | staging | prod  (staging/prod require TOKEN_SECRET; prod hides the fake
# accounts and limits /api/docs to administrator accounts)
#APP_ENV=dev
# /api/docs, /api/redoc, /api/openapi.json: administrators only whenever APP_ENV=prod (cannot be
# switched off there); open in dev/test/qa/staging unless you set this to true to try the gate.
#DOCS_REQUIRE_ADMIN=false

# Signs access tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#TOKEN_SECRET=
#TOKEN_TTL_SECONDS=2592000

# Lets the deploy pipeline publish release manifests (POST /api/v1/release/publish).
#RELEASE_ADMIN_TOKEN=
# Fallback manifest before the first publish (dev convenience).
#RELEASE_FILE=../../apps/web/release.json

# Sync relay limits / retention
#SYNC_OP_TTL_DAYS=30
#SYNC_INACTIVE_DEVICE_DAYS=30
#SYNC_MAX_OP_BYTES=65536
#SYNC_MAX_SNAPSHOT_BYTES=16777216

# Payments (services/account/payments.py, strategy pattern — docs/DEPLOYMENT.md "Payments").
# Methods: stripe | paypal. The account screen always shows a "Pay with …" button per method.
# Without credentials the BUILT-IN FAKES (fakes.py) answer outside prod: fake checkout / portal
# pages under /api/v1/billing/fake/…, signed webhooks, cancel/renew/fail/recover simulation —
# nothing leaves the machine. With credentials the real provider is used (Stripe test keys /
# PAYPAL_ENV=sandbox for development). BILLING_METHODS narrows/orders the list; BILLING_PROVIDER
# is the pre-selected one.
#BILLING_METHODS=stripe,paypal
#BILLING_PROVIDER=stripe
# Built-in fakes for providers without credentials (default: on outside prod, never in prod).
#BILLING_FAKE_PROVIDERS=true
#TRIAL_DAYS=14
#GRACE_DAYS=7
# Prices of the paid memberships (decimal, in BILLING_CURRENCY) — the plan picker, the checkout
# pages and the refunds use them. Stripe is charged exactly these amounts (ad-hoc price data at
# checkout). PayPal subscriptions bill the Plan ids below: create them at PayPal with the same
# amounts (Lifetime is a one-off order at PRICE_LIFETIME).
#BILLING_CURRENCY=USD
#PRICE_PRO_MONTHLY=1.00
#PRICE_PRO_YEARLY=10.00
#PRICE_LIFETIME=20.00
# Refunds on cancellation (the membership ends at once): monthly/yearly give back the unused
# days of the current period (days left ÷ days in the period × amount paid); Lifetime gives back
# this flat amount.
#REFUND_LIFETIME=10.00
# KPI alerts on the administrators' payment dashboard (ads admin console → Payments): warn above
# these, alert above twice them. Rates are fractions.
#PAYMENT_ALERT_FAILURE_RATE=0.10
#PAYMENT_ALERT_REFUND_RATE=0.25
#PAYMENT_ALERT_REVENUE_DROP=0.30
#PAYMENT_ALERT_PAST_DUE=5
#PAYMENT_ALERT_MIN_TRANSACTIONS=5
# Stripe — Dashboard → Developers. Webhook endpoint: <api origin>/api/v1/billing/webhooks/stripe
# with the events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.created/updated/deleted,
# invoice.paid, invoice.payment_failed, charge.refunded.
#STRIPE_SECRET_KEY=sk_test_…
#STRIPE_WEBHOOK_SECRET=whsec_…
# PayPal — developer.paypal.com → Apps & Credentials (REST app). Webhook:
# <api origin>/api/v1/billing/webhooks/paypal with the events BILLING.SUBSCRIPTION.*,
# PAYMENT.SALE.COMPLETED, PAYMENT.SALE.REFUNDED, CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED. Subscriptions need a billing Plan id (P-…)
# per plan, priced like PRICE_PRO_MONTHLY / PRICE_PRO_YEARLY.
# sandbox | live (default: live when APP_ENV=prod, sandbox otherwise).
#PAYPAL_ENV=sandbox
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_WEBHOOK_ID=
#PAYPAL_PLAN_PRO_MONTHLY=P-…
#PAYPAL_PLAN_PRO_YEARLY=P-…

# Membership (docs/MEMBERSHIP.md). Free memberships (anonymous or free account) may keep this many
# active (not done) tasks; paid and administrator memberships are unlimited.
#FREE_MAX_ACTIVE_TASKS=3
# Accounts with these e-mails become administrators when they register/sign in (first admin of a
# deployment; more can be promoted from the admin panel or with `python dev.py promote <email>`).
#ADMIN_EMAILS=you@example.com
# Create the fake test accounts (services/account/seed.py) at startup — dev/test only, never in prod.
#SEED_FAKE_ACCOUNTS=true

# Sponsored content for free memberships (docs/ADVERTISING.md): first-party, contextual, anonymous.
#ADS_ENABLED=true
#ADS_ROTATION_SECONDS=300
#ADS_MAX_PER_RESPONSE=3
#ADS_STATS_RETENTION_DAYS=400
# First-party hosts creative images may come from (empty = text-only creatives).
#ADS_IMAGE_HOSTS=cdn.example.com
# Edge header with the visitor's country (e.g. CF-IPCountry) — used only when the client sent no
# region, never stored. Off by default; mention it in the privacy policy if you turn it on.
#ADS_REGION_HEADER=
# Ads admin console (apps/ads-admin): fold per-country figures below this many impressions into
# "other" in analytics/CSV; optionally serve the console from this process at /ads-admin/.
#ADS_ANALYTICS_MIN_COUNT=5
#ADS_ADMIN_DIST=../../apps/ads-admin
# Where the user app's admin dialog links to ("Ads admin console ↗"); defaults to /ads-admin/
# when ADS_ADMIN_DIST is set, empty (no link) otherwise.
#ADS_ADMIN_URL=https://ads-admin.example.com/
# Ad source (README "Testing each advertisement source", docs/ADVERTISING.md §10):
# internal | sponsored | affiliate | adsense | microsoft | network. The admin panel can switch at runtime.
#ADS_SOURCE=sponsored
# Built-in fakes for third-party providers without credentials (default: on outside prod).
#ADS_FAKE_PROVIDERS=true
# Affiliate links: appended to every affiliate creative's URL.
#ADS_AFFILIATE_TAG=tag=pa-21
# Google AdSense (live tag when both are set).
#ADS_ADSENSE_CLIENT=ca-pub-0000000000000000
#ADS_ADSENSE_SLOT=0000000000
# Microsoft Advertising / pubCenter (live tag when all three are set).
#ADS_MICROSOFT_SITE_ID=
#ADS_MICROSOFT_PUBLISHER_ID=
#ADS_MICROSOFT_AD_UNIT_ID=
# Third-party network: JSON endpoint called server-to-server ({region}/{lang} substituted) …
#ADS_NETWORK_NAME=Acme Ads
#ADS_NETWORK_JSON_URL=https://ads.acme.example/serve?region={region}&lang={lang}
# … or the network's script tag (consent-gated in the browser).
#ADS_NETWORK_SCRIPT_URL=
#ADS_NETWORK_UNIT_ID=
#ADS_NETWORK_PRIVACY_URL=

# Only when the PWA is served from another origin than the API (not needed with Azure SWA linked backend).
#CORS_ORIGINS=https://myapp.azurestaticapps.net

# Serve the built PWA from this process (LAN testing / single-container hosting).
#WEB_DIST=../../apps/web/dist/web/browser

# Run Alembic migrations at API startup for PostgreSQL too (SQLite always does). Single replica only.
#AUTO_MIGRATE=false
