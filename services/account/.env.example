# Copy to services/account/.env to override defaults (all optional locally, required in the cloud).

# PostgreSQL (Azure Database for PostgreSQL Flexible Server in the cloud). SQLite only for tests.
#DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/assistant

# dev | test | qa | staging | prod  (staging/prod require TOKEN_SECRET; prod hides the billing sandbox
# and the fake accounts, and limits /api/docs to administrator accounts)
#APP_ENV=dev
# /api/docs, /api/redoc, /api/openapi.json: administrators only whenever APP_ENV=prod (cannot be
# switched off there); open in dev/test/qa/staging unless you set this to true to try the gate.
#DOCS_REQUIRE_ADMIN=false

# Signs access tokens. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#TOKEN_SECRET=
#TOKEN_TTL_SECONDS=2592000

# Lets the deploy pipeline publish release manifests (POST /api/v1/release/publish).
#RELEASE_ADMIN_TOKEN=
# Fallback manifest before the first publish (dev convenience).
#RELEASE_FILE=../../apps/web/release.json

# Sync relay limits / retention
#SYNC_OP_TTL_DAYS=30
#SYNC_INACTIVE_DEVICE_DAYS=30
#SYNC_MAX_OP_BYTES=65536
#SYNC_MAX_SNAPSHOT_BYTES=16777216

# Billing: stub (built-in sandbox) | paddle | stripe (adapters to be added behind billing.py)
#BILLING_PROVIDER=stub
#BILLING_WEBHOOK_SECRET=
#TRIAL_DAYS=14
#GRACE_DAYS=7

# Membership (docs/MEMBERSHIP.md). Free memberships (anonymous or free account) may keep this many
# active (not done) tasks; paid and administrator memberships are unlimited.
#FREE_MAX_ACTIVE_TASKS=3
# Accounts with these e-mails become administrators when they register/sign in (first admin of a
# deployment; more can be promoted from the admin panel or with `python dev.py promote <email>`).
#ADMIN_EMAILS=you@example.com
# Create the fake test accounts (services/account/seed.py) at startup — dev/test only, never in prod.
#SEED_FAKE_ACCOUNTS=true

# Only when the PWA is served from another origin than the API (not needed with Azure SWA linked backend).
#CORS_ORIGINS=https://myapp.azurestaticapps.net

# Serve the built PWA from this process (LAN testing / single-container hosting).
#WEB_DIST=../../apps/web/dist/web/browser

# Run Alembic migrations at API startup for PostgreSQL too (SQLite always does). Single replica only.
#AUTO_MIGRATE=false
